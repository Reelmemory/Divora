# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# OpenSea market data
OPENSEA_API_KEY=replace-with-your-opensea-key
OPENSEA_COLLECTION_SLUG=

# Chain defaults
DIVORA_CHAIN=robinhood
DIVORA_CHAIN_ID=4663
ROBINHOOD_RPC_URL=

# Explicit collection allowlist (comma-separated contract addresses).
# Empty means policy rejects all trade candidates.
DIVORA_ALLOWED_COLLECTIONS=

# Otari hosted AI gateway
# Create a platform API token in your Otari account.
OTARI_AI_TOKEN=replace-with-your-otari-token
OTARI_BASE_URL=https://api.otari.ai/api/v1
OTARI_MODEL=moonshotai/kimi-k2.6
